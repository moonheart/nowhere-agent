{
  // shadcn-generated components (src/components/ui): never hand-edited, so the
  // pedantic unused-locals/params lint is off here. The registry output keeps an
  // `import * as React` it does not always use; that is the generator's shape,
  // not a defect to fix by hand. Full type safety still applies.
  //
  // This is a composite project so the app references (does not re-compile) it:
  // imported ui files would otherwise be pulled into the app program and checked
  // under its stricter flags. Declarations emit into a cache dir, not dist.
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.ui.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./node_modules/.tmp/ui-types",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",

    /* Linting — unused-locals/params intentionally omitted for generated code */
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Path alias */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Composite projects must list every file pulled in via imports: ui components
  // reach into the shared utils alias and the use-mobile hook, so those ship here
  // too. They stay lint-clean regardless (no strict flags lost that they need).
  "include": ["src/components/ui", "src/lib/utils.ts", "src/hooks/use-mobile.ts"]
}
