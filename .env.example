# Example environment — copy to .env and fill in real values. .env is gitignored.

# --- LLM provider (chat endpoint) ---
# anthropic | openai
LLM_PROVIDER=openai
# Full endpoint URL (used verbatim as the request URL).
#   OpenAI-compatible:    https://new-api.moonheart.dev/v1/chat/completions
#   Anthropic-compatible: https://new-api.moonheart.dev/v1/messages
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# Context window in tokens for in-loop compression. 0 (default) derives it
# from the built-in model capability profile when the model is known;
# set it explicitly for unknown/fine-tuned models.
LLM_CONTEXT_WINDOW=0
# Sampling temperature for chat runs. Unset (default) keeps the provider
# default; reasoning models ignore it per their capability profile.
# LLM_TEMPERATURE=0
# Extended-reasoning token budget (Anthropic thinking). 0 disables.
# LLM_THINKING_BUDGET=0
# Streaming stall detector: fail the stream if no bytes arrive for this long.
# LLM_STREAM_IDLE_TIMEOUT=120s

# --- Postgres ---
DB_DSN=postgres://postgres:postgres@localhost:5432/nowhere?sslmode=disable

# --- Identity / admin console (optional) ---
# The first account to sign up on an empty database becomes a platform admin
# automatically. A database that already has accounts has no admin, so name one
# here: the account with this email is promoted at every startup (idempotent).
# An email matching no account logs a warning and is otherwise ignored. This is
# also the recovery path if the last admin loses the role.
BOOTSTRAP_ADMIN_EMAIL=

# --- Secrets at rest (recommended for any env holding real keys) ---
# Master key that encrypts stored credentials (team LLM provider API keys)
# before they reach Postgres. 32 raw bytes or base64 of 32 bytes. Generate one:
#   openssl rand -base64 32
# Leave EMPTY to store keys plaintext (legacy; the server warns on boot). Once
# set, existing plaintext keys still read and are re-encrypted on next write —
# no flag-day migration. Guard this value: losing it makes stored keys
# unreadable, and rotating it requires re-encrypting existing rows.
SECRETS_MASTER_KEY=

# --- Frontend (optional) ---
# Built frontend dir to serve statically.
WEB_DIR=

# --- Sandbox / built-in file tools (optional) ---
# off (default, no tools) | local | docker
# local confines each session's files under a host dir; docker isolates per session.
SANDBOX_BACKEND=off
# Host root for the local backend's per-session dirs (falls back to WORKSPACE_DIR).
SANDBOX_WORKSPACE_DIR=
# Container egress policy for the docker backend: deny (default, no egress) |
# open (full egress) | allowlist (fails closed until an egress proxy exists).
# The local backend ignores this. Keep deny/allowlist for multi-tenant hosts.
SANDBOX_NETWORK=deny
# Enable run_command on the local backend. The local backend runs commands on
# the host (confined to the workspace working dir), so this defaults OFF — a
# multi-tenant host must use the docker backend instead, where run_command is
# always available and contained.
SANDBOX_LOCAL_EXEC=false
# Override the bash used by local run_command. Empty auto-detects (bash on PATH;
# Git Bash on Windows). Set to your Git Bash bash.exe if detection fails, e.g.
# C:\Program Files\Git\bin\bash.exe
SANDBOX_SHELL=
# Per-session workspace/image storage root (also used by local sandbox when set).
WORKSPACE_DIR=

# --- Subagent (optional) ---
# Enable the spawn_agent tool; bound recursive nesting depth.
SUBAGENT_ENABLED=true
SUBAGENT_MAX_DEPTH=3
# Fan-out budget per request: total subagent runs and how many run concurrently.
SUBAGENT_MAX_TOTAL=32
SUBAGENT_MAX_CONCURRENT=8

# --- MCP / web search (optional) ---
# Modern form: any number of enterprise MCP servers (Streamable HTTP), JSON
# array of {name, url, headers, timeout}. Tools register as mcp_<name>_<tool>.
# Example: enterprise knowledge base + ITSM + SearXNG:
# MCP_SERVERS=[{"name":"searxng","url":"https://searxng-mcp.moonheart.dev/mcp"},{"name":"kb","url":"https://kb.example.com/mcp","headers":{"Authorization":"Bearer x"},"timeout":"45s"}]
MCP_SERVERS=
# Legacy single-server SearXNG form (used only when MCP_SERVERS is empty).
MCP_ENABLED=false
# SearXNG MCP endpoint; default is the hosted instance, override for self-hosted.
MCP_SEARXNG_URL=https://searxng-mcp.moonheart.dev/mcp

# --- http_request tool (enterprise integration) ---
# Comma-separated host allowlist the agent may call: exact hosts, *.subdomains,
# CIDR (10.0.0.0/8), or * (full open). Empty disables the tool entirely —
# no allowlist, no tool.
HTTP_TOOL_ALLOWLIST=
# Bounds one http_request call (the model may lower it per call).
HTTP_TOOL_TIMEOUT=30s

# --- Execution permission (tool risk gate) ---
# Per-risk decision: allow | deny | ask. This server is headless, so "ask" is
# treated as deny (no interactive approver). Defaults permit read-only,
# sandbox-write, and network (the web-search tool); tighten network to deny for
# stricter multi-tenant isolation.
PERMISSION_READ_ONLY=allow
PERMISSION_SANDBOX_WRITE=allow
PERMISSION_NETWORK=allow
PERMISSION_EXTERNAL_WRITE=deny

# --- Dreaming (offline memory consolidation) ---
# The scheduled worker that turns conversation episodes into long-term memory.
# It is the only writer to memory. Off by default: every pass spends LLM tokens.
DREAMING_ENABLED=false
DREAMING_INTERVAL=1h
# Token budget per pass, checked before each stage spends it.
DREAMING_MAX_TOKENS=100000
# Live-memory caps per kind, per scope. Consolidation is told each cap and the
# current count and asked to merge to fit; anything still over is evicted
# oldest-first. Caps are per kind rather than one total because a shared total
# is won by whichever kind generates most freely. There is no "unbounded"
# setting — a non-positive value is rejected at startup.
# fact and preference share DREAMING_MAX_FACTS.
DREAMING_MAX_FACTS=80
DREAMING_MAX_INSIGHTS=30
DREAMING_MAX_SUMMARIES=40
# How long a deprecated memory is kept before permanent deletion (default 30d).
DREAMING_PURGE_AFTER=720h

# --- Scheduled tasks (recurring agent runs) ---
# The trigger that scans for due user tasks and fires each through the same run
# path a human chat uses. On by default; this gates only the firing loop — task
# CRUD via the API stays available with it off. Firing needs an LLM provider.
SCHEDULE_ENABLED=true
# How often the trigger looks for due tasks. Sub-minute cron resolution is not
# supported, so the default 30s is finer than any real schedule.
SCHEDULE_SCAN_INTERVAL=30s
