# Example environment — copy to .env and fill in real values. .env is gitignored.

# --- General ---
# dev | staging | prod
# ENV=dev

# --- LLM provider (SEED-ONLY: provider registry bootstrap) ---
# LLM_PROVIDER / LLM_BASE_URL / LLM_MODEL / LLM_API_KEY are read ONLY by
# `go run ./cmd/migrate -seed-from-env` for a one-time import into the
# provider registry (skipped when the registry is not empty). The running
# server does NOT read them: providers, models, and API keys are DB-managed
# data configured live in the admin console (Providers tab), resolved per
# request — no restart needed. After seeding, manage providers there.
#   anthropic | openai
LLM_PROVIDER=openai
# Full endpoint URL (used verbatim as the request URL).
#   OpenAI-compatible:    https://new-api.moonheart.dev/v1/chat/completions
#   Anthropic-compatible: https://new-api.moonheart.dev/v1/messages
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# --- Vision provider (SEED-ONLY, optional) ---
# VISION_PROVIDER / VISION_BASE_URL / VISION_MODEL / VISION_API_KEY are the
# same one-time seed import as LLM_* above, for a separate vision-capable
# model (marked vision in the registry). When VISION_PROVIDER equals
# LLM_PROVIDER the seeded provider is named "<provider>-vision". Leave all
# four empty to skip; the chat model falls back to the platform default.
#   anthropic | openai
VISION_PROVIDER=
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
# The tunables below ARE read by the server (model-independent LLM behaviour).
# Context window in tokens for in-loop compression. 0 (default) derives it
# from the built-in model capability profile when the model is known;
# set it explicitly for unknown/fine-tuned models.
LLM_CONTEXT_WINDOW=0
# Sampling temperature for chat runs. Unset (default) keeps the provider
# default; reasoning models ignore it per their capability profile.
# LLM_TEMPERATURE=0
# Extended-reasoning token budget (Anthropic thinking). 0 disables.
# LLM_THINKING_BUDGET=0
# Streaming stall detector: fail the stream if no bytes arrive for this long.
# LLM_STREAM_IDLE_TIMEOUT=120s
# Agent loop iteration cap (think→tool→think). 0 = built-in default (25).
# LLM_MAX_ITERATIONS=25
# Language of the built-in system prompts: en (default) | zh.
# LLM_SYSTEM_LANG=en
# Record every raw LLM request/response to <dir>/<provider>/... (no auth
# headers); older than LLM_RAW_LOG_RETENTION_DAYS (default 7) are swept.
# LLM_RAW_LOG_DIR=
# LLM_RAW_LOG_RETENTION_DAYS=7

# --- Postgres ---
DB_DSN=postgres://postgres:postgres@localhost:5432/nowhere?sslmode=disable
# Connection pool tuning (leave at defaults unless you know why you need more).
# DB_MAX_OPEN_CONNS=20
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=30m

# --- Logging ---
# debug|info|warn|error, and text|json output format.
# LOG_LEVEL=debug
# LOG_FORMAT=text

# --- HTTP gateway ---
# Listen address; defaults to :8080.
# HTTP_ADDR=:8080
# Server timeouts.
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=60s
# HTTP_SHUTDOWN_TIMEOUT=15s
# Per-client rate limit (0 = disabled; set both to enable).
# HTTP_RATE_LIMIT_RPS=0
# HTTP_RATE_LIMIT_BURST=0
# Comma-separated reverse-proxy CIDRs whose X-Forwarded-For/X-Real-IP are
# honored for client-IP resolution. Empty = socket peer only (secure default).
# HTTP_TRUSTED_PROXY_CIDRS=
# Secure attribute on the OIDC state cookie. Default true; set false ONLY for
# a plain-HTTP local/dev deployment (a Secure cookie is never sent otherwise).
# HTTP_COOKIE_SECURE=true

# --- Live stream broker ---
# mem (default, single instance) | redis (fan out across instances).
# STREAM_BROKER=mem
# Redis address when STREAM_BROKER=redis.
# REDIS_ADDR=localhost:6379

# --- Identity / admin console (optional) ---
# The first account to sign up on an empty database becomes a platform admin
# ONLY when this variable is set (the legacy bootstrap, for fresh deployments
# that opt in). A database that already has accounts has no admin, so name one
# here: the account with this email is promoted at every startup (idempotent).
# An email matching no account logs a warning and is otherwise ignored. This is
# also the recovery path if the last admin loses the role. Leave unset on a
# public deployment: the first random signup must not claim the admin role.
BOOTSTRAP_ADMIN_EMAIL=

# --- Secrets at rest (recommended for any env holding real keys) ---
# Master key that encrypts stored credentials (team LLM provider API keys)
# before they reach Postgres. 32 raw bytes or base64 of 32 bytes. Generate one:
#   openssl rand -base64 32
# Leave EMPTY to store keys plaintext (legacy; the server warns on boot). Once
# set, existing plaintext keys still read and are re-encrypted on next write —
# no flag-day migration. Guard this value: losing it makes stored keys
# unreadable, and rotating it requires re-encrypting existing rows.
SECRETS_MASTER_KEY=

# --- Frontend (optional) ---
# Built frontend dir to serve statically.
WEB_DIR=

# --- Sandbox / built-in file tools (optional) ---
# off (default, no tools) | local | docker
# local confines each session's files under a host dir; docker isolates per session.
SANDBOX_BACKEND=off
# Host root for the local backend's per-session dirs (falls back to WORKSPACE_DIR).
SANDBOX_WORKSPACE_DIR=
# Container egress policy for the docker backend: deny (default, no egress) |
# open (full egress) | allowlist (fails closed until an egress proxy exists).
# The local backend ignores this. Keep deny/allowlist for multi-tenant hosts.
SANDBOX_NETWORK=deny
# Enable run_command on the local backend. The local backend runs commands on
# the host (confined to the workspace working dir), so this defaults OFF — a
# multi-tenant host must use the docker backend instead, where run_command is
# always available and contained.
SANDBOX_LOCAL_EXEC=false
# Override the bash used by local run_command. Empty auto-detects (bash on PATH;
# Git Bash on Windows). Set to your Git Bash bash.exe if detection fails, e.g.
# C:\Program Files\Git\bin\bash.exe
SANDBOX_SHELL=
# Per-session workspace/image storage root (also used by local sandbox when set).
WORKSPACE_DIR=
# How long an ENDED session's image dir is kept before the hourly sweep
# (default 30; <= 0 disables the sweep).
# WORKSPACE_RETENTION_DAYS=30

# --- Subagent (optional) ---
# Enable the spawn_agent tool; bound recursive nesting depth.
SUBAGENT_ENABLED=true
SUBAGENT_MAX_DEPTH=3
# Fan-out budget per request: total subagent runs and how many run concurrently.
SUBAGENT_MAX_TOTAL=32
SUBAGENT_MAX_CONCURRENT=8

# --- MCP / web search (optional) ---
# Modern form: any number of enterprise MCP servers (Streamable HTTP), JSON
# array of {name, url, headers, timeout}. Tools register as mcp_<name>_<tool>.
# Example: enterprise knowledge base + ITSM + SearXNG:
# MCP_SERVERS=[{"name":"searxng","url":"https://searxng-mcp.moonheart.dev/mcp"},{"name":"kb","url":"https://kb.example.com/mcp","headers":{"Authorization":"Bearer x"},"timeout":"45s"}]
MCP_SERVERS=
# Legacy single-server SearXNG form (used only when MCP_SERVERS is empty).
MCP_ENABLED=false
# SearXNG MCP endpoint; default is the hosted instance, override for self-hosted.
MCP_SEARXNG_URL=https://searxng-mcp.moonheart.dev/mcp

# --- http_request tool (enterprise integration) ---
# Comma-separated host allowlist the agent may call: exact hosts, *.subdomains,
# CIDR (10.0.0.0/8), or * (full open). Empty disables the tool entirely —
# no allowlist, no tool.
HTTP_TOOL_ALLOWLIST=
# Bounds one http_request call (the model may lower it per call).
HTTP_TOOL_TIMEOUT=30s
# Per-run cap on concurrent tool executions across the whole tool registry.
# HTTP_TOOL_MAX_CONCURRENT=8

# --- query_db tool (enterprise integration) ---
# Comma-separated "name=DSN" entries for the read-only business databases the
# agent may query (postgres:// or mysql://). Empty disables the tool.
# QUERY_DB_DSNS=
# Bounds one query_db call.
# QUERY_DB_TIMEOUT=15s

# --- Image uploads ---
# One knob, two scopes (0 = unlimited; overridable live in the admin console):
# per USER for user-level uploads (uploads/<id>.webp, tracked in the uploads
# table) and per SESSION for a chat session's own images (counted from the
# session's stored files). A user with N sessions can hold up to N session
# caps plus one user cap.
# UPLOAD_MAX_FILES_PER_USER=200
# UPLOAD_MAX_BYTES_PER_USER=209715200

# --- PII/secret redaction (enterprise-readiness) ---
# Rewrites emails/cards/IPs/keys in tool results before they reach the model
# or the durable record. Off by default.
# REDACT_ENABLED=false
# redact (whole value -> [REDACTED_<TYPE>]) | mask (keep last 4 chars).
# REDACT_STRATEGY=redact
# Comma-separated subset of email, credit_card, ipv4, bearer, basic_auth,
# api_key, private_key, secret_value. Empty = all.
# REDACT_CATEGORIES=

# --- Outbound webhooks (run completion notifications) ---
# Global target URL; a scheduled task's own webhook_url wins. Empty disables.
# WEBHOOK_URL=
# WEBHOOK_TIMEOUT=10s
# WEBHOOK_RETRIES=3
# Comma-separated CIDRs/hostnames allowed to receive webhooks even when they
# resolve private (the delivery SSRF guard is always on; empty = public only).
# WEBHOOK_SSRF_ALLOWLIST=
# HMAC-SHA256 signing secret for X-Nowhere-Signature (empty = unsigned).
# WEBHOOK_SIGNING_SECRET=

# --- OIDC single sign-on (optional) ---
# Disabled unless OIDC_ISSUER is set (discovered via <issuer>/.well-known).
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Callback URL; must match the value registered at the IdP.
# OIDC_REDIRECT_URL=http://localhost:8080/auth/oidc/callback
# OIDC_SCOPES=openid profile email

# --- Phone + SMS-OTP login (optional) ---
# Disabled unless PHONE_SMS_URL is set. Endpoint receives {"phone","code"};
# special value "log://" prints codes to the server log (dev only).
# PHONE_SMS_URL=
# PHONE_SMS_TIMEOUT=10s

# --- Execution permission (tool risk gate) ---
# Per-risk decision: allow | deny | ask. "ask" suspends the run and shows an
# approval card in the chat UI (it only equals deny when no client consumes the
# suspension). Defaults permit read-only, sandbox-write, and network (the
# web-search tool); external-write (long-term memory tools, future
# out-of-workspace writers) asks first — the user approves or rejects each call.
# Tighten network to deny for stricter multi-tenant isolation.
PERMISSION_READ_ONLY=allow
PERMISSION_SANDBOX_WRITE=allow
PERMISSION_NETWORK=allow
PERMISSION_EXTERNAL_WRITE=ask

# --- Dreaming (offline memory consolidation) ---
# The scheduled worker that turns conversation episodes into long-term memory.
# It is the only writer to memory. Off by default: every pass spends LLM tokens.
DREAMING_ENABLED=false
DREAMING_INTERVAL=1h
# Token budget per pass, checked before each stage spends it.
DREAMING_MAX_TOKENS=100000
# Live-memory caps per kind, per scope. Consolidation is told each cap and the
# current count and asked to merge to fit; anything still over is evicted
# oldest-first. Caps are per kind rather than one total because a shared total
# is won by whichever kind generates most freely. There is no "unbounded"
# setting — a non-positive value is rejected at startup.
# fact and preference share DREAMING_MAX_FACTS.
DREAMING_MAX_FACTS=80
DREAMING_MAX_INSIGHTS=30
DREAMING_MAX_SUMMARIES=40
# How long a deprecated memory is kept before permanent deletion (default 30d).
DREAMING_PURGE_AFTER=720h

# --- Scheduled tasks (recurring agent runs) ---
# The trigger that scans for due user tasks and fires each through the same run
# path a human chat uses. On by default; this gates only the firing loop — task
# CRUD via the API stays available with it off. Firing needs an LLM provider.
SCHEDULE_ENABLED=true
# How often the trigger looks for due tasks. Sub-minute cron resolution is not
# supported, so the default 30s is finer than any real schedule.
SCHEDULE_SCAN_INTERVAL=30s
