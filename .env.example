# Example environment — copy to .env and fill in real values. .env is gitignored.

# --- LLM provider (chat endpoint) ---
# anthropic | openai
LLM_PROVIDER=openai
# Full endpoint URL (used verbatim as the request URL).
#   OpenAI-compatible:    https://new-api.moonheart.dev/v1/chat/completions
#   Anthropic-compatible: https://new-api.moonheart.dev/v1/messages
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=

# --- Postgres ---
DB_DSN=postgres://postgres:postgres@localhost:5432/nowhere?sslmode=disable

# --- Frontend (optional) ---
# Built frontend dir to serve statically.
WEB_DIR=
